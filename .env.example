# Copy once as .env on the host. Not overwritten by down/pull/up.
JARVIS_PORT=8766
HOST_BIND=127.0.0.1
# Required if HOST_BIND is anything other than loopback (16+ chars).
JARVIS_TOKEN=
SEMANTIC_ENABLED=false
OLLAMA_TIMEOUT=240

# Free self-hosted public search (SearXNG JSON API, no paid accounts).
WEB_SEARCH_ENABLED=true
# Optional Google Gemini fallback. OFF until a key is configured locally.
# Generate a key at https://aistudio.google.com/apikey and do NOT share it in chat/Git.
# With enabled=true, public search requests go to Gemini + Google Search automatically.
# Personal/HA conversation context is never supplied to Gemini.
# Free limits/model access depend on your Google AI Studio project.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=50
# Optional: random secret for internal SearXNG instance.
SEARXNG_SECRET=jarvis-local-search-change-this
