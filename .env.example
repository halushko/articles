# Copy once as .env on the host. Not overwritten by down/pull/up.
JARVIS_PORT=8766
HOST_BIND=127.0.0.1
# Required if HOST_BIND is anything other than loopback (16+ chars).
JARVIS_TOKEN=
SEMANTIC_ENABLED=false
OLLAMA_TIMEOUT=240

# Free self-hosted public search (SearXNG JSON API, no paid accounts).
WEB_SEARCH_ENABLED=true
# Free Gemini generation for stand-alone PUBLIC questions and SearXNG summaries.
# Disabled until you deliberately configure a local key from https://aistudio.google.com/apikey
# This does NOT enable Google Search Grounding (which may have zero free quota).
# No SQLite memory, actor identity, HA data or history is sent to Gemini.
# web_mode=off disables SEARCH, not PUBLIC Gemini generation when enabled.
# The conservative data filter is not a complete DLP system.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=50
# Optional: random secret for internal SearXNG instance.
SEARXNG_SECRET=jarvis-local-search-change-this
